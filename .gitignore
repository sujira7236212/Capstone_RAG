# --- secrets ---
# .env holds a live GOOGLE_API_KEY and the two DATABASE_URLs. Never commit it;
# .env.example carries the key names instead.
.env

# --- environment / build artefacts ---
.venv/
__pycache__/
*.pyc

# --- machine-local editor & tool state ---
.claude/
.vscode/

# --- large or regenerable data ---
# data/ (the KB's source documents) IS committed; see data/README.md for its layout.
# excluded_from_kb/ (36 MB) holds the third-party PDFs dropped from older KB versions;
# they are static and carry their own licensing.
excluded_from_kb/
# Byte-identical (or same-paper) copies pulled out of data/ so the curator does not
# curate the same paper twice; kept only so the rule-named filing is not lost.
data_duplicates/

# Raw dump from tools/legacy/check_chunks.py (~550 KB), regenerable.
chunk_results.txt

# --- caches ---
# kb_rerank.py's cross-encoder scores, keyed by model + query + chunk text; rebuilt on demand.
.cache/
