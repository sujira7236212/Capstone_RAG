# Copy to .env and fill in. .env is gitignored.

# Google Gemini API key - used for both the LLM (gemini-3.5-flash-lite) and, when
# embedding_config.DEFAULT_MODE is "gemini", the embeddings.
GOOGLE_API_KEY=

# pgvector connection strings. embedding_config.get_connection() picks between them.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=
DATABASE_URL_LOCAL=

# Groq (free tier): eval/generate_groq.py, eval/judge_pairwise.py, and the feedback service
# when FEEDBACK_LLM_PROVIDER=groq.
GROQ_API_KEY=

# Feedback service (python -m service; all optional, see service/app.py).
# The app's Supabase Postgres, filled by tools/copy_kb.py. Unset: DATABASE_URL.
KB_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# gemini (default) or groq.
FEEDBACK_LLM_PROVIDER=
